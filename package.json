{
  "name": "neongate-ai",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "tokens:build": "node src/identity/tokens/scripts/build-tokens.mjs",
    "dev": "pnpm tokens:build && next dev",
    "build": "pnpm tokens:build && next build",
    "start": "next start",
    "check": "pnpm lint && pnpm typecheck",
    "format": "biome format --write --vcs-use-ignore-file=true .",
    "format:check": "biome format .",
    "lint": "biome check .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "motion": "13.1.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": "24.x"
  }
}
